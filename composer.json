{
    "name": "ahmed29345/laravel-wathq",
    "description": "Typed Laravel client for Wathq (Saudi Ministry of Commerce data API) to verify commercial registration numbers.",
    "keywords": ["laravel", "wathq", "saudi-arabia", "commercial-registration", "ministry-of-commerce", "kyb"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Muhammad Ahmed Raza Memon",
            "homepage": "https://github.com/ahmed29345"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/translation": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmed29345\\Wathq\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmed29345\\Wathq\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmed29345\\Wathq\\WathqServiceProvider"
            ],
            "aliases": {
                "Wathq": "Ahmed29345\\Wathq\\Facades\\Wathq"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
